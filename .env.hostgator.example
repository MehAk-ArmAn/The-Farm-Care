APP_NAME="The Farm Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://thefarmcare.com
APP_TIMEZONE=Asia/Dubai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Replace values with the exact database/user names created in HostGator cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_thefarmcare
DB_USERNAME=CPANELUSER_tfcuser
DB_PASSWORD=CHANGE_TO_STRONG_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.thefarmcare.com
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configure with the mailbox/SMTP values available in the HostGator account.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.thefarmcare.com
MAIL_PORT=587
MAIL_USERNAME=info@thefarmcare.com
MAIL_PASSWORD=CHANGE_TO_MAIL_PASSWORD
MAIL_FROM_ADDRESS="info@thefarmcare.com"
MAIL_FROM_NAME="${APP_NAME}"
